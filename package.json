{
  "name": "murphy",
  "private": true,
  "description": "Murphy breaks your webhooks so production can't.",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @murphy/db db:migrate",
    "db:seed": "pnpm --filter @murphy/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.0"
  }
}
