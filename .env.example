# Copy to .env and adjust. Never commit .env.

# Credentials for the Postgres container in infra/docker-compose.yml. Pick your own password,
# e.g. with: openssl rand -hex 16
POSTGRES_USER=murphy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=murphy

# Must match the values above (host port 54320 by default). .env files do not expand
# variables, so repeat them here.
DATABASE_URL=postgresql://murphy:change-me@localhost:54320/murphy?schema=public

# Redis from infra/docker-compose.yml (host port 56379 by default).
REDIS_URL=redis://localhost:56379

# 32 random bytes, base64-encoded. Used for AES-256-GCM encryption of endpoint signing
# secrets at rest. Generate with:
#   openssl rand -base64 32
MURPHY_ENCRYPTION_KEY=

# Port the API listens on.
PORT=3000

# Delivery safety mode for the worker. Defaults to "hosted" when unset: https only, public
# addresses only. Set "local" to deliver to http://localhost and LAN addresses during
# development (cloud metadata addresses stay blocked).
# MURPHY_MODE=local

# Replaces the retry schedule with comma-separated milliseconds, for the chaos harness (ADR 010).
# The worker refuses to start with this set unless MURPHY_MODE=local. Leave unset.
# WORKER_RETRY_SCHEDULE_MS=

# How often a worker looks for finished simulator runs, in milliseconds. Default 1000.
# WORKER_RUN_FINISH_INTERVAL_MS=
