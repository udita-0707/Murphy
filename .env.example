# Copy to .env and adjust. Never commit .env.

# Postgres from infra/docker-compose.yml (host port 54320 by default).
DATABASE_URL=postgresql://murphy:murphy@localhost:54320/murphy?schema=public

# Redis from infra/docker-compose.yml (host port 56379 by default).
REDIS_URL=redis://localhost:56379

# 32 random bytes, base64-encoded. Used for AES-256-GCM encryption of endpoint signing
# secrets at rest. Generate with:
#   openssl rand -base64 32
MURPHY_ENCRYPTION_KEY=

# Port the API listens on.
PORT=3000
