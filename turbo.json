{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "5",
  "globalEnv": ["DATABASE_URL", "REDIS_URL", "MURPHY_ENCRYPTION_KEY", "PORT"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
